#include<iostream.h>
#include<conio.h>
class demo
{
	private:
		int a,b;
	public:
		void input()
		{
			cout<<"Enter value for A:";
			cin>>a;
			cout<<"Enter value for B:";
			cin>>b;
		}
		void output();
};
void demo :: output()
{
	cout<<"\n A:"<<a;
	cout<<"\n B:"<<b;
}
void main()
{
	clrscr();
	demo d1;
	d1.input();
	d1.output();
	getch();
}