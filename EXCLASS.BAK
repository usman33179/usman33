#include<iostream.h>
#include<conio.h>
class demo
{
	int a;
	float b;
	char c;
	public:
		void get()
		{
			cout<<"\n Enter an int A float B and char C:";
			cin>>a>>b>>c;
		}
		void put();
};
void demo::put()
{
	cout<<"\n A="<<a;
	cout<<"\n B="<<b;
	cout<<"\n C="<<c;
}
void main()
{
	demo d1;
	clrscr();
	d1.get();
	d1.put();
	getch();
}